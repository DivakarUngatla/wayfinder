# OpenAI API Key (required for the LLM-powered agent)
OPENAI_API_KEY=<<Insert your OpenAI API key here>>

# LangSmith API Key (required for evaluation scripts)
# Replace the value below with your actual API key
LANGSMITH_API_KEY=<<Insert your langsmith api key here>>

# Optional: Enable LangSmith tracing for full visibility
LANGSMITH_TRACING=true
